<odoo>
    <record id="privilege_github" model="ir.module.category">
        <field name="name">GitHub CI/CD</field>
    </record>
    <record id="group_viewer" model="res.groups">
        <field name="name">Viewer</field><field name="category_id" ref="privilege_github"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_operator" model="res.groups">
        <field name="name">Operator</field><field name="category_id" ref="privilege_github"/>
        <field name="implied_ids" eval="[(4, ref('group_viewer'))]"/>
    </record>
    <record id="group_admin" model="res.groups">
        <field name="name">Administrator</field><field name="category_id" ref="privilege_github"/>
        <field name="implied_ids" eval="[(4, ref('group_operator'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
