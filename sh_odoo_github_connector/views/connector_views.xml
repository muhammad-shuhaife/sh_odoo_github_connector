<odoo>
    <record id="project_list" model="ir.ui.view"><field name="name">sh.github.project.list</field><field name="model">sh.github.project</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="name"/><field name="owner"/><field name="repository"/><field name="branch"/></list></field></record>
    <record id="project_form" model="ir.ui.view"><field name="name">sh.github.project.form</field><field name="model">sh.github.project</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><sheet><group><field name="name"/><field name="owner"/><field name="repository"/><field name="branch"/></group></sheet></form></field></record>
    <record id="run_list" model="ir.ui.view"><field name="name">sh.github.run.list</field><field name="model">sh.github.run</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="create_date"/><field name="project_id"/><field name="operation"/><field name="state"/><field name="conclusion"/></list></field></record>
    <record id="run_form" model="ir.ui.view"><field name="name">sh.github.run.form</field><field name="model">sh.github.run</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><sheet><group><field name="project_id"/><field name="request_id"/><field name="operation"/><field name="state"/><field name="conclusion"/><field name="commit_sha"/><field name="error_message"/><field name="log"/></group></sheet></form></field></record>
    <record id="project_action" model="ir.actions.act_window"><field name="name">Archived Projects</field><field name="res_model">sh.github.project</field><field name="view_mode">list,form</field></record>
    <record id="run_action" model="ir.actions.act_window"><field name="name">Old Pipeline History</field><field name="res_model">sh.github.run</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_github" name="GitHub" web_icon="sh_odoo_github_connector,static/description/icon.png" sequence="80" groups="sh_odoo_github_connector.group_viewer"/>
    <record id="menu_projects" model="ir.ui.menu"><field name="name">Archived Projects</field><field name="parent_id" ref="menu_github"/><field name="action" ref="project_action"/><field name="active">False</field></record>
    <record id="menu_runs" model="ir.ui.menu"><field name="name">Old Pipeline History</field><field name="parent_id" ref="menu_github"/><field name="action" ref="run_action"/><field name="sequence">80</field><field name="active">True</field><field name="groups_id" eval="[(6, 0, [ref('base.group_no_one')])]"/></record>
</odoo>
